[Unit]
Description=MControlCenter: undo a battery calibration that was cut short (power loss / crash)
Documentation=https://github.com/p34t1k/MControlCenter
ConditionPathExists=/var/lib/mcontrolcenter/calibration.orig

[Service]
Type=oneshot
ExecStart=/usr/libexec/mcontrolcenter/mcontrolcenter-battery boot

[Install]
WantedBy=multi-user.target
