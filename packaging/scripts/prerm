#!/bin/sh
# $1 is "remove" (deb) or 0 (rpm) on a real removal, "upgrade" / 1 on upgrade: only clean up on removal
case "$1" in
    remove|0)
        # never leave a calibration half done
        [ -x /usr/libexec/mcontrolcenter/mcontrolcenter-battery ] && /usr/libexec/mcontrolcenter/mcontrolcenter-battery restore >/dev/null 2>&1 || true
        systemctl disable mcontrolcenter-doctor.service mcontrolcenter-battery.service >/dev/null 2>&1 || true ;;
esac
exit 0
